---
// How-to steps, features, FAQ and related tools below each tool.
import AdSlot from "./AdSlot.astro";
import OtherTools from "./OtherTools.astro";
import type { ToolSlug } from "../tools";

interface Props {
  slug: ToolSlug;
  /** Heading for the steps, e.g. "How to convert an image". */
  howToTitle: string;
  steps: { title: string; body: string }[];
  features: { title: string; body: string }[];
  faqs: { q: string; a: string }[];
}
const { slug, howToTitle, steps, features, faqs } = Astro.props;

const ld = [
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    name: howToTitle,
    step: steps.map((s, i) => ({ "@type": "HowToStep", position: i + 1, name: s.title, text: s.body })),
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
  },
];
---

<div class="no-print">
  <section class="mx-auto mt-20 max-w-6xl px-4 sm:px-6" aria-labelledby="howto">
    <h2 id="howto" class="text-2xl font-semibold tracking-tight sm:text-3xl">{howToTitle}</h2>
    <ol class="mt-8 grid gap-4 md:grid-cols-3">
      {
        steps.map((s, i) => (
          <li class="card p-6">
            <span class="font-mono text-xs text-accent">{String(i + 1).padStart(2, "0")}</span>
            <h3 class="mt-3 font-semibold tracking-tight">{s.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{s.body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="mx-auto mt-20 max-w-6xl px-4 sm:px-6" aria-labelledby="features">
    <h2 id="features" class="text-2xl font-semibold tracking-tight sm:text-3xl">Features</h2>
    <div class="mt-8 grid gap-px overflow-hidden rounded-2xl border border-line bg-line sm:grid-cols-2 lg:grid-cols-3">
      {
        features.map((f) => (
          <div class="bg-bg p-6">
            <h3 class="font-semibold tracking-tight">{f.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{f.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <AdSlot name="inContent" class="mt-16" />

  <section class="mx-auto mt-20 max-w-3xl px-4 sm:px-6" aria-labelledby="faq">
    <h2 id="faq" class="text-2xl font-semibold tracking-tight sm:text-3xl">Frequently asked questions</h2>
    <div class="mt-8 divide-y divide-line border-y border-line">
      {
        faqs.map((f) => (
          <details class="group" data-smooth>
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 font-medium [&::-webkit-details-marker]:hidden">
              {f.q}
              <svg class="size-4 shrink-0 text-subtle transition-transform duration-300 group-[.is-open]:rotate-45" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                <path d="M12 5v14M5 12h14" />
              </svg>
            </summary>
            <p class="pb-5 text-sm leading-relaxed text-muted">{f.a}</p>
          </details>
        ))
      }
    </div>
  </section>

  <OtherTools slug={slug} />

  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
</div>

<script>
  import { smoothDetails } from "../lib/accordion";
  smoothDetails();
</script>
