---
import ToolLayout from "@devsam/ui/layouts/ToolLayout.astro";
import ToolHero from "@devsam/ui/components/ToolHero.astro";
import AdSlot from "@devsam/ui/components/AdSlot.astro";
import Explainer from "@devsam/ui/components/Explainer.astro";
import Breadcrumbs from "@devsam/ui/components/Breadcrumbs.astro";
import TopicSection from "@devsam/ui/components/TopicSection.astro";
import Resizer from "./Resizer";
import { generalTopic, pages, type ResizePageData } from "../data/pages";

interface Props {
  variant?: ResizePageData;
}
const { variant: v } = Astro.props;

const sharedFaqs = [
  { q: "Are my photos uploaded?", a: "No. Resizing runs entirely in your browser. Your photos never leave your device." },
  { q: "Can I make an image bigger?", a: "Yes, but enlarging can't add detail, so very small images may look soft. For the best results, start from the largest original you have." },
];
const homeFaqs = [
  { q: "What size should Instagram posts be?", a: "1080×1080 for square posts, 1080×1350 for portrait posts, which take up the most space in the feed, and 1080×1920 for stories and Reels." },
  { q: "How do I make my whole photo fit as a WhatsApp DP?", a: "Choose WhatsApp, Profile photo, then select Fit with border. The full photo stays visible on a square background in the colour you choose." },
  { q: "Is the passport size accurate for printing?", a: "Yes. 35×45 mm and 2×2 inch presets are calculated at 300 DPI, the standard for photo printing. Always check your country's rules for head size and background colour." },
];
---

<ToolLayout
  slug="resize"
  title={v?.title ?? "Image Resizer — Resize & Crop Photos Online Free | devsam"}
  description={v?.description ??
    "Resize and crop images to any size or to presets for Instagram, WhatsApp, YouTube, X, LinkedIn and passports. Batch resize, free, nothing is uploaded."}
>
  {v && <Breadcrumbs slug="resize" current={v.label} />}
  <ToolHero
    title={v?.h1 ?? "Resize and crop images, perfectly framed"}
    intro={v?.intro ?? "Pick a size for Instagram, WhatsApp, YouTube, passports or anything custom. Drag to frame the photo, then download."}
  />

  <section id="tool" class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="card p-3 sm:p-5">
      <Resizer client:load defaultPreset={v?.preset ?? "ig-post"} />
    </div>
  </section>

  <AdSlot name="belowTool" class="mt-10" />

  <section class="mx-auto mt-16 max-w-6xl px-4 sm:px-6" aria-labelledby="variants">
    <h2 id="variants" class="label">Resize for</h2>
    <ul class="mt-4 flex flex-wrap gap-2">
      <li><a href="/" class:list={["pill transition-colors hover:text-fg", !v && "border-accent text-fg"]}>Any size</a></li>
      {
        pages.map((x) => (
          <li>
            <a href={`/${x.slug}/`} class:list={["pill transition-colors hover:text-fg", x.slug === v?.slug && "border-accent text-fg"]}>
              {x.label}
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <TopicSection topic={v?.topic ?? generalTopic} />

  <Explainer
    slug="resize"
    howToTitle={v ? `How to resize a photo for ${v.label}` : "How to resize an image"}
    steps={[
      { title: "Choose a size", body: v ? `The ${v.label} size is already selected. Pick another from the Size menu if you need to.` : "Pick a preset for Instagram, WhatsApp, YouTube, Facebook, X, LinkedIn or passports, or enter a custom size." },
      { title: "Add and frame your photos", body: "Drop one or more images. Drag a photo to choose what stays in frame and use the slider to zoom." },
      { title: "Download", body: "Download a JPG, PNG or WebP at the exact size. Several photos download together as a ZIP." },
    ]}
    features={[
      { title: "Exact social sizes", body: "Presets follow each platform's recommended upload sizes, so nothing gets cropped or blurred after you post." },
      { title: "You choose the framing", body: "Drag and zoom to keep faces and products in shot, instead of an automatic centre crop." },
      { title: "Fit without cropping", body: "Fit with border keeps the whole photo and fills the gap with a colour you pick. Popular for WhatsApp DPs." },
      { title: "Batch resize", body: "Resize many photos to the same size at once, each with its own framing, and download a ZIP." },
      { title: "Sharp results", body: "Large reductions use step-by-step downscaling for crisp detail instead of jagged edges." },
      { title: "Private", body: "Everything happens in your browser. Photos are never uploaded, and location data is removed." },
    ]}
    faqs={v ? [...v.faqs, ...sharedFaqs] : [...homeFaqs, ...sharedFaqs]}
  />
</ToolLayout>
