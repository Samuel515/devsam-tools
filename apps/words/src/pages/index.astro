---
import ToolLayout from "@devsam/ui/layouts/ToolLayout.astro";
import ToolHero from "@devsam/ui/components/ToolHero.astro";
import AdSlot from "@devsam/ui/components/AdSlot.astro";
import Explainer from "@devsam/ui/components/Explainer.astro";
import WordCounter from "../components/WordCounter";
---

<ToolLayout
  slug="words"
  title="Word Counter — Count Words, Characters & Reading Time Free | devsam"
  description="Free word and character counter. See sentences, paragraphs, reading time, keyword density and limits for X, SMS and meta descriptions as you type."
>
  <ToolHero
    title="Count words and characters"
    intro="Paste or type your text to see word count, characters, reading time and your most-used words, updated as you type."
    chips={["Updates as you type", "Nothing is sent", "Free"]}
  />

  <section id="tool" class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="card p-3 sm:p-5">
      <WordCounter client:load />
    </div>
  </section>

  <AdSlot name="belowTool" class="mt-10" />

  <Explainer
    slug="words"
    howToTitle="How to count words"
    steps={[
      { title: "Paste or type", body: "Paste your essay, article, post or any text into the box, or start typing." },
      { title: "Read the numbers", body: "Words, characters, sentences, paragraphs and reading time update instantly." },
      { title: "Check limits and keywords", body: "See whether you fit X, SMS or SEO limits, and which words you use most." },
    ]}
    features={[
      { title: "Accurate counts", body: "Hyphenated words and contractions count as one word, and emoji count as one character." },
      { title: "Reading and speaking time", body: "Based on average reading speed of 238 words per minute and a speaking pace of 150." },
      { title: "Keyword density", body: "See your most frequent words and their share of the text, with common words filtered out." },
      { title: "Platform limits", body: "Progress bars for X posts, SMS, meta descriptions, page titles, Instagram and LinkedIn." },
      { title: "Change case", body: "Convert text to UPPERCASE, lowercase, Title Case or Sentence case in one click." },
      { title: "Private and saved", body: "Your text stays in your browser and is kept for next time on this device only." },
    ]}
    faqs={[
      { q: "Is my text sent anywhere?", a: "No. Counting happens in your browser. Your text is saved only in this browser's local storage so it's still here if you close the tab." },
      { q: "How is reading time calculated?", a: "Word count divided by 238 words per minute, the average silent reading speed for adults. Speaking time uses 150 words per minute." },
      { q: "Does it count words in other languages?", a: "Yes, for any language that separates words with spaces, including Yoruba, Igbo, Hausa, French and Arabic. For languages written without spaces, like Chinese, use the character count instead." },
      { q: "How many words is a 5-minute speech?", a: "About 750 words at a comfortable pace of 150 words per minute. Paste your script to see its speaking time." },
      { q: "What counts as a sentence?", a: "Text ending in a full stop, question mark, exclamation mark or ellipsis. Abbreviations like 'e.g.' can occasionally add an extra sentence." },
    ]}
  />
</ToolLayout>
