---
import ToolLayout from "@devsam/ui/layouts/ToolLayout.astro";
import ToolHero from "@devsam/ui/components/ToolHero.astro";
import AdSlot from "@devsam/ui/components/AdSlot.astro";
import Explainer from "@devsam/ui/components/Explainer.astro";
import PasswordTool from "./PasswordTool";
import Breadcrumbs from "@devsam/ui/components/Breadcrumbs.astro";
import TopicSection from "@devsam/ui/components/TopicSection.astro";
import { variants, mainTopic, type Variant } from "../data/variants";

interface Props {
  variant?: Variant;
}
const { variant: v } = Astro.props;
---

<ToolLayout
  slug="password"
  title={v?.title ?? "Strong Password Generator — Secure Passwords & Passphrases | devsam"}
  description={v?.description ?? "Generate strong, random passwords and memorable passphrases with your browser's secure random generator. Check password strength. Nothing is sent or stored."}
>
  {v && <Breadcrumbs slug="password" current={v.label} />}
  <ToolHero
    title={v?.h1 ?? "Generate a strong password"}
    intro={v?.intro ?? "Truly random passwords and easy-to-remember passphrases, made on your device with cryptographic randomness."}
    chips={["Made on your device", "Never stored", "Cryptographically random"]}
  />

  <section id="tool" class="mx-auto max-w-3xl px-4 sm:px-6">
    <div class="card p-4 sm:p-6">
      <PasswordTool client:load defaultMode={v ? "phrase" : "password"} />
    </div>
  </section>

  <AdSlot name="belowTool" class="mt-10" />

  <section class="mx-auto mt-16 max-w-6xl px-4 sm:px-6" aria-labelledby="variants">
    <h2 id="variants" class="label">Also try</h2>
    <ul class="mt-4 flex flex-wrap gap-2">
      <li><a href="/" class:list={["pill transition-colors hover:text-fg", !v && "border-accent text-fg"]}>{mainTopic.label}</a></li>
      {
        variants.map((x) => (
          <li>
            <a href={`/${x.slug}/`} class:list={["pill transition-colors hover:text-fg", x.slug === v?.slug && "border-accent text-fg"]}>
              {x.label}
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <TopicSection topic={v?.topic ?? mainTopic.topic} />

  <Explainer
    slug="password"
    howToTitle="How to create a strong password"
    steps={[
      { title: "Choose a type", body: "Password for maximum strength in a password manager, or Passphrase for something you can remember and type." },
      { title: "Adjust the options", body: "Longer is stronger. 16+ characters, or 6+ words, is strong enough for almost anything." },
      { title: "Copy and save it", body: "Copy it straight into your password manager or the sign-up form. Click the arrows for a new one." },
    ]}
    features={[
      { title: "Cryptographically random", body: "Uses your browser's secure random number generator, with no bias towards any character." },
      { title: "Memorable passphrases", body: "Random words from the EFF's 7,776-word list, which are much easier to remember than random characters." },
      { title: "Every character type", body: "Each password is guaranteed to include every character type you choose." },
      { title: "No look-alikes", body: "Optionally avoid characters like I, l, 1, O and 0 that are easy to misread." },
      { title: "Strength checker", body: "See how long a password would take to crack, measured in bits of entropy." },
      { title: "Nothing leaves your device", body: "Passwords are made in your browser. They're never sent anywhere, logged or stored." },
    ]}
    faqs={[
      ...(v?.faqs ?? []),
      { q: "Are these passwords stored or sent anywhere?", a: "No. Passwords are generated in your browser with the Web Crypto API. They're never sent over the network, logged or saved." },
      { q: "How long should my password be?", a: "At least 16 characters for random passwords, which gives about 100 bits of entropy with all character types, or 6 words for passphrases, about 77 bits. Both are far beyond what attackers can guess." },
      { q: "Is a passphrase as safe as a random password?", a: "A 6-word passphrase from a 7,776-word list has about 77 bits of entropy, similar to a 13-character random password, and is much easier to remember and type." },
      { q: "How is crack time calculated?", a: "It assumes an attacker who has stolen a password database can try 10 billion guesses per second, and finds yours after searching half the possibilities. Real-world times vary." },
      { q: "Should I reuse a strong password?", a: "No. Use a different password for every account and store them in a password manager, so one leak can't unlock everything." },
    ]}
  />

  <p class="mx-auto mt-10 max-w-3xl px-4 text-xs text-subtle sm:px-6">
    Passphrase word list: <a class="underline" href="https://www.eff.org/dice" rel="noopener" target="_blank">EFF Large Wordlist</a>, © Electronic Frontier Foundation, licensed under CC BY 3.0 US.
  </p>
</ToolLayout>
